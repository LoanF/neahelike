# Copier ce fichier en .env.local et remplir les valeurs.

# URL publique du site (aperçus des liens, redirections OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de données Supabase : Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.xxxx:motdepasse@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Migrations automatiques (appliquées au déploiement de production uniquement)
# Connexion dédiée aux migrations : Supabase → Connect → Session pooler (port 5432). Sinon DATABASE_URL est utilisée.
DATABASE_URL_MIGRATIONS=
# Schéma(s) Postgres gérés par Drizzle, séparés par des virgules
DB_SCHEMAS=public
# Mettre à false pour couper les migrations automatiques
DB_AUTO_MIGRATE=true

# Auth.js : générer avec `npx auth secret` ou `openssl rand -base64 33`
AUTH_SECRET=

# Application Discord : https://discord.com/developers/applications → OAuth2
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Bot Discord (même application, onglet Bot) : lit les rôles, donne les rôles, envoie les MP
DISCORD_BOT_TOKEN=

# Serveur Discord et rôles (clic droit → Copier l'identifiant, mode développeur activé)
DISCORD_GUILD_ID=
# Rangs du site : un ou plusieurs ID de rôles séparés par des virgules (ex. Conseiller,Technopoios)
DISCORD_ROLE_STAFF=
DISCORD_ROLE_RECRUTEUR=
# Donné quand la candidature est validée : débloque les vocaux pour passer la whitelist (« attente de wl »)
DISCORD_ROLE_ASPIRANT=
# Donné quand le vocal est réussi et la whitelist validée sur le tableau de bord (« Magistrat (wl) »)
DISCORD_ROLE_HELIKEEN=
# Rôle de base (« Novice (Non WL) ») : rendu au joueur quand le staff supprime son compte du portail
DISCORD_ROLE_NOVICE=

# Mettre à true le jour de l'ouverture pour autoriser l'indexation par Google
NEXT_PUBLIC_INDEXABLE=false
