# Copier ce fichier en .env.local et remplir les valeurs.

# URL publique du site (aperçus des liens, redirections OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base de données Supabase : Project Settings → Database → Connection string → Transaction pooler
DATABASE_URL=postgresql://postgres.xxxx:motdepasse@aws-0-eu-west-3.pooler.supabase.com:6543/postgres

# Auth.js : générer avec `npx auth secret` ou `openssl rand -base64 33`
AUTH_SECRET=

# Application Discord : https://discord.com/developers/applications → OAuth2
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Bot Discord (même application, onglet Bot) : lit les rôles, donne les rôles, envoie les MP
DISCORD_BOT_TOKEN=

# Serveur Discord et rôles (clic droit → Copier l'identifiant, mode développeur activé)
DISCORD_GUILD_ID=
DISCORD_ROLE_RECRUTEUR=
DISCORD_ROLE_STAFF=
# Donné dès la liaison du compte
DISCORD_ROLE_INITIE=
# Donné quand le background est validé (attente du vocal)
DISCORD_ROLE_ASPIRANT=
# Donné quand le vocal est réussi (whitelisté)
DISCORD_ROLE_HELIKEEN=
