# Copier ce fichier en .env.local et remplir les valeurs.

# URL publique du site (aperçus des liens, redirections OAuth)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Base PostgreSQL (n'importe quel hébergeur ; un pooler en mode transaction fonctionne aussi)
DATABASE_URL=postgres://utilisateur:motdepasse@localhost:5432/nea

# Migrations automatiques au build (scripts/migrate.mjs) : sur Vercel en production, ou ailleurs avec MIGRATE_FORCE=true
# Connexion dédiée aux migrations (connexion directe ou pooler en mode session). Sinon DATABASE_URL est utilisée.
DATABASE_URL_MIGRATIONS=
# Schéma(s) Postgres gérés par Drizzle, séparés par des virgules
DB_SCHEMAS=public
# Mettre à false pour couper les migrations automatiques
DB_AUTO_MIGRATE=true
# Mettre à true pour migrer au build hors de Vercel
MIGRATE_FORCE=false

# Auth.js : générer avec `npx auth secret` ou `openssl rand -base64 33`
AUTH_SECRET=

# Application Discord : https://discord.com/developers/applications → OAuth2
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=

# Bot Discord (même application, onglet Bot) : lit les rôles, donne les rôles, envoie les MP
DISCORD_BOT_TOKEN=

# Serveur Discord et rôles (clic droit → Copier l'identifiant, mode développeur activé)
DISCORD_GUILD_ID=
# Rangs du site : un ou plusieurs ID de rôles séparés par des virgules (ex. Conseiller,Technopoios)
# Réglage de secours : les rôles se gèrent depuis le site (Administration › Rôles et permissions).
DISCORD_ROLE_ADMIN=
DISCORD_ROLE_RECRUTEUR=
# Donné quand la candidature est validée : débloque les vocaux pour passer la whitelist (« attente de wl »)
DISCORD_ROLE_ATTENTE_WL=
# Donné quand le vocal est réussi et la whitelist validée sur le tableau de bord (« Magistrat (wl) »)
DISCORD_ROLE_WL=
# Rôle de base (« Novice (Non WL) ») : rendu au joueur quand un admin supprime son compte du portail
DISCORD_ROLE_NON_WL=

# Mettre à true le jour de l'ouverture pour autoriser l'indexation par Google
NEXT_PUBLIC_INDEXABLE=false
